{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aetiusgular/tk/library/schema/tk-skill.schema.json",
  "title": "tk library skill index record (skill.json)",
  "description": "ToolHive's skill.json shape (thv-skill.schema.json beside this file, from stacklok/toolhive-core, read 27 Oct 2026: namespace, name ^[a-z0-9][a-z0-9-]*[a-z0-9]$ to 64, description to 1024, version, status active|deprecated|archived, title to 100, license, compatibility to 500, allowedTools, repository, icons, packages oci|git) plus tk's _meta in the same position as a server.json, with kind \"skill\". The SKILL.md itself sits in the git package's subfolder and is checked against the Agent Skills specification (agentskills.io, read 27 Oct 2026) by the validator, not by this schema. Lane E.",
  "type": "object",
  "required": ["namespace", "name", "description", "version", "packages", "_meta"],
  "properties": {
    "namespace": { "type": "string", "minLength": 3, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "title": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "deprecated", "archived"] },
    "license": { "type": "string", "maxLength": 256 },
    "compatibility": { "type": "string", "maxLength": 500 },
    "allowedTools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_-]+/[A-Za-z0-9_-]+$" } },
    "repository": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string", "pattern": "^https://" }, "type": { "type": "string" } }
    },
    "icons": {
      "type": "array",
      "items": { "type": "object", "required": ["src"], "properties": { "src": { "type": "string" }, "type": { "type": "string" } } }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["registryType", "url", "ref", "subfolder"],
            "properties": {
              "registryType": { "const": "git" },
              "url": { "type": "string", "pattern": "^https://" },
              "ref": { "type": "string", "minLength": 1 },
              "subfolder": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]*$" }
            }
          },
          {
            "type": "object",
            "required": ["registryType", "identifier"],
            "properties": {
              "registryType": { "const": "oci" },
              "identifier": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "_meta": {
      "type": "object",
      "required": ["io.modelcontextprotocol.registry/publisher-provided"],
      "properties": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "type": "object",
          "required": ["io.github.aetiusgular.tk"],
          "properties": {
            "io.github.aetiusgular.tk": {
              "allOf": [
                { "$ref": "https://github.com/aetiusgular/tk/contracts/entry.schema.json" },
                { "type": "object", "properties": { "kind": { "const": "skill" } } }
              ]
            }
          }
        }
      }
    }
  }
}
