{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aetiusgular/tk/library/schema/sets.schema.json",
  "title": "tk catalog sets (library/catalog/sets.json)",
  "description": "Named sets of catalog entries that the exporters turn into one marketplace.json, one Docker profile, one Pi package and one ToolHive registry each. An id is the entry's folder name under library/catalog/. Lane E, 27 Oct 2026.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sets"],
  "properties": {
    "version": { "const": 1 },
    "sets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "entries"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "entries": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
        }
      }
    }
  }
}
