{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aetiusgular/tk/library/schema/tk-server.schema.json",
  "title": "tk library server entry",
  "description": "An upstream server.json (2025-12-11, vendored beside this file as server.schema.json, checked separately by the validator because it is draft-07) that also carries the tk data object at _meta[\"io.modelcontextprotocol.registry/publisher-provided\"][\"io.github.aetiusgular.tk\"] (contracts/entry.schema.json) with kind \"server\". This file adds only what the library requires on top of upstream: the $schema pin, the tk _meta object, and a package or a remote. Lane E, 27 Oct 2026.",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "description",
    "version",
    "_meta"
  ],
  "properties": {
    "$schema": {
      "const": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$",
      "minLength": 3,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "registryType",
          "identifier",
          "transport"
        ],
        "properties": {
          "registryType": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "transport": {
            "type": "object"
          }
        }
      }
    },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "io.modelcontextprotocol.registry/publisher-provided"
      ],
      "properties": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "type": "object",
          "required": [
            "io.github.aetiusgular.tk"
          ],
          "properties": {
            "io.github.aetiusgular.tk": {
              "allOf": [
                {
                  "$ref": "https://github.com/aetiusgular/tk/contracts/entry.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "server"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "packages"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "remotes"
      ],
      "properties": {
        "remotes": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ]
}
