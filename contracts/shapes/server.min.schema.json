{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aetiusgular/tk/contracts/shapes/server.min.schema.json",
  "title": "The parts of upstream server.json (2025-12-11) the contract relies on",
  "description": "A subset, read 27 Oct 2026 from https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json: ServerDetail requires name, description, version; name pattern ^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$ (3 to 200); a package requires registryType, identifier, transport; a remote requires type (streamable-http or sse) and url; the top level has no additionalProperties keyword. Lane E vendors the full upstream schema; this file only lets session 0's fixtures be checked.",
  "type": "object",
  "required": ["$schema", "name", "description", "version", "_meta"],
  "properties": {
    "$schema": { "const": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json" },
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$", "minLength": 3, "maxLength": 200 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["registryType", "identifier", "transport"],
        "properties": {
          "registryType": { "type": "string" },
          "identifier": { "type": "string" },
          "transport": { "type": "object" }
        }
      }
    },
    "remotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": { "type": { "enum": ["streamable-http", "sse"] }, "url": { "type": "string" } }
      }
    },
    "_meta": {
      "type": "object",
      "required": ["io.modelcontextprotocol.registry/publisher-provided"],
      "properties": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "type": "object",
          "required": ["io.github.aetiusgular.tk"],
          "properties": { "io.github.aetiusgular.tk": { "$ref": "../entry.schema.json" } }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["packages"], "properties": { "packages": { "type": "array", "minItems": 1 } } },
    { "required": ["remotes"], "properties": { "remotes": { "type": "array", "minItems": 1 } } }
  ]
}
