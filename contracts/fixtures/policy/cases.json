    { "id": 5, "call": { "tool": "mcp__github__create_issue", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "ask", "normalizedTool": "github/create_issue", "reasonPrefix": "rule" } },
    { "id": 6, "call": { "tool": "mcp__github__get_issue", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "allow", "normalizedTool": "github/get_issue", "reasonPrefix": "rule" } },
    { "id": 7, "call": { "tool": "mcp__plugin_tk_github__get_issue", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "ask", "normalizedTool": "plugin_tk_github/get_issue", "reasonPrefix": "no rule" },
      "note": "a plugin's server keeps its whole name, so github/get_issue's allow does not reach it (integration w2, finding S5)" },
    { "id": 8, "call": { "tool": "Bash", "harness": "claude-code", "inputText": "ls -la" },
      "expect": { "action": "allow", "normalizedTool": "bash", "reasonPrefix": "rule" } },
    { "id": 9, "call": { "tool": "bash", "harness": "codex", "inputText": "ls" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "rule" } },
    { "id": 10, "call": { "tool": "Bash", "harness": "claude-code", "inputText": "echo $HOME" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" } },
