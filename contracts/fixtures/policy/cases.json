      "note": "every bare server the plugin's could be narrows it: evil_my_server, my_server, server (S5)" },
    { "id": 49, "call": { "tool": "mcp__plugin_tk_exa__search", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "allow", "normalizedTool": "plugin_tk_exa/search", "reasonPrefix": "rule plugin_tk_exa/*" },
      "note": "a rule naming the plugin's server allows it (S5)" },
    { "id": 50, "call": { "tool": "mcp__plugin_tk_exa__delete_index", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "deny", "normalizedTool": "plugin_tk_exa/delete_index", "reasonPrefix": "rule exa/delete_index" },
      "note": "the plugin's own allow does not outrank a deny on the bare server (S5)" },
    { "id": 51, "call": { "tool": "mcp__exa__x__search", "harness": "pi", "inputText": "" },
      "expect": { "action": "ask", "normalizedTool": "exa/x__search", "reasonPrefix": "ambiguous server name" },
      "note": "Claude Code allows a server named exa__x; with no servers entry to settle the split, an allow asks (S5)" }
  ]
