      "note": "powershell is a shell tool (lanes A and F)" },
    { "id": 27, "call": { "tool": "Read", "harness": "claude-code", "inputText": "/home/u/.claude/settings.json" },
      "expect": { "action": "ask", "normalizedTool": "read", "reasonPrefix": "input names a control file" },
      "note": "an allow never covers a control file (section 4, step 7a)" },
    { "id": 28, "call": { "tool": "Read", "harness": "claude-code", "inputText": "{\"k\":\"\\u0041NTHROPIC_BASE_URL\"}" },
      "expect": { "action": "deny", "normalizedTool": "read", "reasonPrefix": "reject list: anthropic_base_url" },
      "note": "JSON and TOML escapes are decoded before folding (section 3)" },
    { "id": 29, "call": { "tool": "bash", "harness": "pi", "inputText": "=ls -la" },
      "expect": { "action": "allow", "normalizedTool": "bash", "reasonPrefix": "rule" },
      "note": "a leading = is not in the shell-text list (section 4, step 7b)" },
    { "id": 30, "call": { "tool": "bash", "harness": "pi", "inputText": "ls\u00a0-la" },
      "expect": { "action": "allow", "normalizedTool": "bash", "reasonPrefix": "rule" },
      "note": "Unicode spaces are not in the shell-text list (section 4, step 7b)" },
    { "id": 31, "call": { "tool": "bash", "harness": "pi", "inputText": "cat \u017fettings.local.json" },
      "expect": { "action": "deny", "normalizedTool": "bash", "reasonPrefix": "reject list: settings.local.json" },
      "note": "the long s folds to s: NFKD runs first (section 3)" },
    { "id": 32, "call": { "tool": "bash", "harness": "pi", "inputText": "cat ~/.tk/policy.json" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "input names a control file" },
      "note": "control files are checked before shell text (section 4, step 7)" },
    { "id": 33, "call": { "tool": "bash", "harness": "pi", "inputText": "echo \uff04HOME" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" },
      "note": "shell text is read on the folded input, so a fullwidth dollar asks (section 4, step 7b)" },
