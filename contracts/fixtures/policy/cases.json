      "expect": { "action": "deny", "normalizedTool": "bash", "reasonPrefix": "reject list: anthropic_base_url" },
      "note": "quotes split a key; the reject list also reads the input with quotes removed (integration w1 security finding S1)" },
    { "id": 35, "call": { "tool": "bash", "harness": "pi", "inputText": "g''it -c core.fsmonitor=./x status" },
      "expect": { "action": "deny", "normalizedTool": "bash", "reasonPrefix": "reject list: core.fsmonitor" },
      "note": "empty quotes inside a word; the git context is read with quotes removed too (S1)" },
    { "id": 36, "call": { "tool": "bash", "harness": "pi", "inputText": "sed -i s/a/b/ /home/u/.cl\"aude\"/settings.json" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "input names a control file" },
      "note": "control files are also read with quotes removed (S1)" },
    { "id": 37, "call": { "tool": "bash", "harness": "pi", "inputText": "cat /run/user/1000/tk/dae*.token" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" },
      "note": "a glob names files the matcher cannot see (S1)" },
    { "id": 38, "call": { "tool": "bash", "harness": "pi", "inputText": "cp p.json /home/u/.t[k]/policy.json" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" },
      "note": "a bracket glob (S1)" },
    { "id": 39, "call": { "tool": "bash", "harness": "pi", "inputText": "cat /home/u/.cl?ude/settings.json" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" },
      "note": "a ? glob (S1)" },
    { "id": 40, "call": { "tool": "bash", "harness": "pi", "inputText": "ls src/*.ts" },
      "expect": { "action": "ask", "normalizedTool": "bash", "reasonPrefix": "shell text the matcher cannot read" },
      "note": "the cost of S1: any glob in an allowed shell command asks" },
    { "id": 41, "call": { "tool": "Read", "harness": "claude-code", "inputText": "/repo/.git/config" },
      "expect": { "action": "ask", "normalizedTool": "read", "reasonPrefix": "input names a control file" },
      "note": "a repository's git config can name commands (cases 27, 31; S4)" },
    { "id": 42, "call": { "tool": "Read", "harness": "claude-code", "inputText": "/repo/.git/hooks/post-checkout" },
      "expect": { "action": "ask", "normalizedTool": "read", "reasonPrefix": "input names a control file" },
      "note": "a git hook runs on the next checkout (S4)" },
    { "id": 43, "call": { "tool": "Read", "harness": "claude-code", "inputText": "/home/u/.gitconfig" },
      "expect": { "action": "ask", "normalizedTool": "read", "reasonPrefix": "input names a control file" },
      "note": "your own git config (S4)" },
    { "id": 44, "call": { "tool": "Read", "harness": "claude-code", "inputText": "git \\\n-c core.fsmonitor=./x status" },
      "expect": { "action": "deny", "normalizedTool": "read", "reasonPrefix": "reject list: core.fsmonitor" },
      "note": "a line that ends in a backslash continues the git context on the next line, in every matcher (integration w1, finding S10)" },
    { "id": 45, "call": { "tool": "Read", "harness": "claude-code", "inputText": "/repo/.claude/commands/deploy.md" },
      "expect": { "action": "ask", "normalizedTool": "read", "reasonPrefix": "input names a control file" },
      "note": "a harness's whole project folder (.claude/, .codex/, .pi/) holds settings, hooks and instructions it loads; a shell workdir there is caught the same way (integration w1, finding S7)" },
    { "id": 46, "call": { "tool": "mcp__plugin_evil_exa__search", "harness": "claude-code", "inputText": "" },
      "expect": { "action": "ask", "normalizedTool": "plugin_evil_exa/search", "reasonPrefix": "no rule" },
      "note": "exa/*'s allow does not reach a plugin's server called exa (S5)" },
    { "id": 47, "call": { "tool": "mcp__plugin_evil_exa__delete_index", "harness": "claude-code", "inputText": "" },
